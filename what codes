-- ตัวช่วยจัดการตัวละคร / การเชื่อมต่อ
local base = setmetatable({}, { __mode = "k" })
local function getHum()
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h and not base[h] then -- จำค่าเดิมก่อนแก้อะไรทั้งหมด
		base[h] = {
			ws = h.WalkSpeed, jp = h.JumpPower, jh = h.JumpHeight,
			ujp = h.UseJumpPower, hip = h.HipHeight, slope = h.MaxSlopeAngle,
		}
	end
	return h, h and base[h]
end
local function getRoot()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local conns = {}
local function bind(key, signal, fn)
	if not conns[key] then conns[key] = signal:Connect(fn) end
end
local function unbind(key)
	if conns[key] then conns[key]:Disconnect(); conns[key] = nil end
end

local origGravity = workspace.Gravity
local origFov = workspace.CurrentCamera.FieldOfView
local origZoom = player.CameraMaxZoomDistance
local origClock = Lighting.ClockTime
local origLight
local flySpeed, fovValue, clockValue = 60, 100, 14
local espObjs, espConns, espAdded = {}, {}, nil

local function espFor(plr)
	if plr == player then return end
	local function onChar(c)
		if espObjs[plr] then espObjs[plr]:Destroy() end
		local hl = Instance.new("Highlight")
		hl.FillColor = C.yellow
		hl.OutlineColor = C.yellowDim
		hl.FillTransparency = .6
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = c
		espObjs[plr] = hl
	end
	if plr.Character then onChar(plr.Character) end
	espConns[plr] = plr.CharacterAdded:Connect(onChar)
end

-- apply() เรียกซ้ำได้ (ตอนเปลี่ยนค่า / เกิดใหม่), revert() คืนค่าเดิม
local MODS = {
	{ name = "SPEED", value = 50, min = 0, max = 1000, respawn = true,
		apply = function(v) local h = getHum(); if h then h.WalkSpeed = v end end,
		revert = function() local h, b = getHum(); if h then h.WalkSpeed = b.ws end end },

	{ name = "JUMP POWER", value = 100, min = 0, max = 1000, respawn = true,
		apply = function(v) local h = getHum(); if h then h.UseJumpPower = true; h.JumpPower = v end end,
		revert = function()
			local h, b = getHum()
			if h then h.UseJumpPower = b.ujp; h.JumpPower = b.jp; h.JumpHeight = b.jh end
		end },

	{ name = "GRAVITY", value = 50, min = 0, max = 500,
		apply = function(v) workspace.Gravity = v end,
		revert = function() workspace.Gravity = origGravity end },

	{ name = "INFINITE JUMP",
		apply = function()
			bind("inf", UIS.JumpRequest, function()
				local h = getHum()
				if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
			end)
		end,
		revert = function() unbind("inf") end },

	{ name = "FLY", value = 60, min = 1, max = 500,
		apply = function(v)
			flySpeed = v
			bind("fly", RunService.Heartbeat, function()
				local h, r = getHum(), getRoot()
				if not h or not r then return end
				h.PlatformStand = true
				local cf = workspace.CurrentCamera.CFrame
				local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
				local dir = Vector3.zero
				local md = h.MoveDirection
				if look.Magnitude > 0 and md.Magnitude > 0 then
					look = look.Unit
					local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z).Unit
					dir = cf.LookVector * md:Dot(look) + cf.RightVector * md:Dot(right)
				end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
				r.AssemblyLinearVelocity = dir * flySpeed
			end)
		end,
		revert = function()
			unbind("fly")
			local h = getHum()
			if h then h.PlatformStand = false end
		end },

	{ name = "NOCLIP",
		apply = function()
			bind("noclip", RunService.Stepped, function()
				local c = player.Character
				if not c then return end
				for _, part in ipairs(c:GetDescendants()) do
					if part:IsA("BasePart") then part.CanCollide = false end
				end
			end)
		end,
		revert = function()
			unbind("noclip")
			local c = player.Character
			if not c then return end
			for _, n in ipairs({ "HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso" }) do
				local part = c:FindFirstChild(n)
				if part then part.CanCollide = true end
			end
		end },

	{ name = "HIP HEIGHT", value = 6, min = -10, max = 100, respawn = true,
		apply = function(v) local h = getHum(); if h then h.HipHeight = v end end,
		revert = function() local h, b = getHum(); if h then h.HipHeight = b.hip end end },

	{ name = "MAX SLOPE", value = 89, min = 0, max = 89, respawn = true,
		apply = function(v) local h = getHum(); if h then h.MaxSlopeAngle = v end end,
		revert = function() local h, b = getHum(); if h then h.MaxSlopeAngle = b.slope end end },

	{ name = "FOV", value = 100, min = 30, max = 120,
		apply = function(v)
			fovValue = v
			bind("fov", RunService.RenderStepped, function()
				workspace.CurrentCamera.FieldOfView = fovValue
			end)
		end,
		revert = function()
			unbind("fov")
			workspace.CurrentCamera.FieldOfView = origFov
		end },

	{ name = "MAX ZOOM", value = 500, min = 10, max = 10000,
		apply = function(v) player.CameraMaxZoomDistance = v end,
		revert = function() player.CameraMaxZoomDistance = origZoom end },

	{ name = "FULLBRIGHT",
		apply = function()
			if not origLight then
				origLight = {
					Brightness = Lighting.Brightness, Ambient = Lighting.Ambient,
					OutdoorAmbient = Lighting.OutdoorAmbient,
					GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd,
				}
			end
			Lighting.Brightness = 3
			Lighting.Ambient = Color3.fromRGB(200, 200, 200)
			Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 1e6
		end,
		revert = function()
			if origLight then
				for k, v in pairs(origLight) do Lighting[k] = v end
				origLight = nil
			end
		end },

	{ name = "TIME OF DAY", value = 14, min = 0, max = 24,
		apply = function(v)
			clockValue = v
			bind("time", RunService.RenderStepped, function() Lighting.ClockTime = clockValue end)
		end,
		revert = function()
			unbind("time")
			Lighting.ClockTime = origClock
		end },

	{ name = "PLAYER ESP",
		apply = function()
			if espAdded then return end
			for _, p in ipairs(Players:GetPlayers()) do espFor(p) end
			espAdded = Players.PlayerAdded:Connect(espFor)
		end,
		revert = function()
			if espAdded then espAdded:Disconnect(); espAdded = nil end
			for _, c in pairs(espConns) do c:Disconnect() end
			table.clear(espConns)
			for _, hl in pairs(espObjs) do hl:Destroy() end
			table.clear(espObjs)
		end },
}

local states = {}
for i, def in ipairs(MODS) do
	local st = { on = false, value = def.value }
	states[def] = st

	local row = mk("Frame", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.field,
		BackgroundTransparency = .25, BorderSizePixel = 0, LayoutOrder = i,
	}, modsPage)
	stroke(row, C.yellowDim, 1)

	local nl = label(row, def.name, 13, C.text)
	nl.Position = UDim2.fromOffset(8, 0)
	nl.Size = UDim2.new(1, -140, 1, 0)
	nl.TextXAlignment = Enum.TextXAlignment.Left

	local sw = mk("TextButton", {
		Text = "", AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0),
		Size = UDim2.fromOffset(44, 22), BackgroundColor3 = C.btn, BorderSizePixel = 0,
	}, row)
	stroke(sw, C.yellowDim, 1)
	local knob = mk("Frame", {
		Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = C.yellowDim, BorderSizePixel = 0,
	}, sw)
	local function paint()
		sw.BackgroundColor3 = st.on and C.yellow or C.btn
		knob.Position = st.on and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
		knob.BackgroundColor3 = st.on and C.text or C.yellowDim
	end

	if def.value then
		local vb = mk("TextBox", {
			Text = tostring(def.value), AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -60, .5, 0), Size = UDim2.fromOffset(60, 22),
			BackgroundColor3 = C.btn, BorderSizePixel = 0,
			Font = Enum.Font.Code, TextSize = 13, TextColor3 = C.text,
			ClearTextOnFocus = false,
		}, row)
		stroke(vb, C.yellowDim, 1)
		vb.FocusLost:Connect(function()
			local n = tonumber(vb.Text)
			if n then
				n = math.clamp(n, def.min, def.max)
				st.value = n
				if st.on then def.apply(n) end
			end
			vb.Text = tostring(st.value)
		end)
	end

	sw.Activated:Connect(function()
		st.on = not st.on
		if st.on then def.apply(st.value) else def.revert() end
		paint()
	end)
end

