	local b = button(panel, "📄   ไฟล์ใหม่ (txt ฯลฯ)", UDim2.new(1, -28, 0, 44), UDim2.fromOffset(14, 104), TINT, TINT2, BROWN)
	a.TextSize, b.TextSize = 18, 18
	stroke(a, LINE, 1)
	stroke(b, LINE, 1)
	a.MouseButton1Click:Connect(function() newFolderIn(cur) end)
	b.MouseButton1Click:Connect(function() newFileIn(cur) end)
end)

backBtn.MouseButton1Click:Connect(function()
