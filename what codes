	local back = box({ Position = UDim2.fromOffset(18, 26), Size = UDim2.fromOffset(120, 88), BackgroundColor3 = FOLDER }, parent)
	stroke(back, EDGE, 1.5)
	local front = box({ Position = UDim2.fromOffset(18, 40), Size = UDim2.fromOffset(120, 74), BackgroundColor3 = FOLDER2 }, parent)
	stroke(front, EDGE, 1.5)
	drawIcon(parent, icon, 38, 78, 78)
end

local function extOf(name)
	local e = string.match(name, "%.(%w+)$")
	return e and string.upper(string.sub(e, 1, 4)) or "FILE"
end

local function drawFile(parent, name)
	local page = box({ Position = UDim2.fromOffset(48, 10), Size = UDim2.fromOffset(60, 92), BackgroundColor3 = WHITE }, parent)
	stroke(page, EDGE, 2)
	box({ Position = UDim2.fromOffset(8, 10), Size = UDim2.fromOffset(44, 3), BackgroundColor3 = TINT2 }, page)
	box({ Position = UDim2.fromOffset(8, 18), Size = UDim2.fromOffset(32, 3), BackgroundColor3 = TINT2 }, page)
	box({ Position = UDim2.fromOffset(8, 26), Size = UDim2.fromOffset(38, 3), BackgroundColor3 = TINT2 }, page)
	local tag = box({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56), Size = UDim2.fromOffset(48, 22), BackgroundColor3 = BROWN }, page)
	label({ Size = UDim2.fromScale(1, 1), Text = extOf(name), TextSize = 14, Font = Enum.Font.SourceSansBold, TextColor3 = WHITE }, tag)
end

---------------------------------------------------------------------
-- แสดงรายการ
---------------------------------------------------------------------
local render

local function collectAll(node, out)
	for _, k in ipairs(node.kids or {}) do
		table.insert(out, { node = k, parent = node })
		if k.kids then collectAll(k, out) end
	end
	return out
end

local function openFolder(item)
	if query ~= "" then
		query = ""
		searchBox.Text = ""
		path = { root }
	end
	table.insert(path, item)
	render()
end

local function editItem(entry)
	local item = entry.node
	if item.t == "f" then
		folderDialog(item, function(name, icon)
			item.name, item.icon = name, icon
			markDirty()
			render()
		end)
	else
		fileDialog(item, function(name, text)
			item.name, item.content = name, text
			markDirty()
			render()
			toast("บันทึกไฟล์แล้ว")
		end)
	end
end

local function deleteItem(entry)
	confirmDialog("ลบ “" .. entry.node.name .. "” ?" .. (entry.node.t == "f" and "\nของที่อยู่ข้างในจะหายทั้งหมด" or ""), function()
		local idx = table.find(entry.parent.kids, entry.node)
		if idx then table.remove(entry.parent.kids, idx) end
		markDirty()
		render()
	end)
end

local function makeCard(entry, order)
	local item = entry.node
	local card = make("TextButton", { LayoutOrder = order, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, scroll)
	local inner = box({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = TINT, BackgroundTransparency = 1 }, card)

	if item.t == "f" then drawFolder(inner, item.icon) else drawFile(inner, item.name) end

	label({
		Position = UDim2.fromOffset(6, 118), Size = UDim2.new(1, -12, 0, 26), Text = item.name,
		TextSize = 17, Font = Enum.Font.SourceSansSemibold, TextTruncate = Enum.TextTruncate.AtEnd,
	}, inner)

	local edit = button(inner, "แก้", UDim2.fromOffset(30, 22), UDim2.new(1, -68, 0, 4), WHITE, TINT2, BROWN)
	local del = button(inner, "ลบ", UDim2.fromOffset(30, 22), UDim2.new(1, -34, 0, 4), WHITE, TINT2, BROWN)
	edit.TextSize, del.TextSize = 14, 14
	stroke(edit, LINE, 1)
	stroke(del, LINE, 1)

	card.MouseEnter:Connect(function()
		tween(inner, 0.12, { BackgroundTransparency = 0, Position = UDim2.fromOffset(0, -3) })
	end)
	card.MouseLeave:Connect(function()
		tween(inner, 0.12, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 0) })
	end)
	card.MouseButton1Click:Connect(function()
		if item.t == "f" then openFolder(item) else editItem(entry) end
	end)
	edit.MouseButton1Click:Connect(function() editItem(entry) end)
	del.MouseButton1Click:Connect(function() deleteItem(entry) end)
end

function render()
	for _, c in ipairs(scroll:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end

	local cur = path[#path]
	local entries = {}
	if query ~= "" then
		local q = string.lower(query)
		for _, e in ipairs(collectAll(root, {})) do
			if string.find(string.lower(e.node.name), q, 1, true) then table.insert(entries, e) end
		end
		crumb.Text = "ผลการค้นหา: " .. query
	else
		for _, k in ipairs(cur.kids) do table.insert(entries, { node = k, parent = cur }) end
		local names = {}
		for _, p in ipairs(path) do table.insert(names, p.name) end
		crumb.Text = table.concat(names, "  >  ")
	end

	backBtn.Visible = (#path > 1 and query == "")
	crumb.Position = backBtn.Visible and UDim2.fromOffset(54, 0) or UDim2.fromOffset(14, 0)

	local order = 0
	for _, e in ipairs(entries) do
		if e.node.t == "f" then order += 1 makeCard(e, order) end
	end
	for _, e in ipairs(entries) do
		if e.node.t ~= "f" then order += 1 makeCard(e, order) end
	end

	if #entries == 0 then
		if query ~= "" then
			emptyLabel.Text = "ไม่พบสิ่งที่ค้นหา"
		elseif #path == 1 then
			emptyLabel.Text = "ยังไม่มีแฟ้ม\nกด “+ เพิ่ม” เพื่อสร้างแฟ้มแรก"
		else
			emptyLabel.Text = "แฟ้มนี้ยังว่างอยู่\nกด “+ เพิ่ม” เพื่อใส่แฟ้มหรือไฟล์"
		end
		emptyLabel.Visible = true
	else
		emptyLabel.Visible = false
	end
end

