end

noB.Activated:Connect(function() dialog.Visible = false end)
okB.Activated:Connect(function()
	local trimmed = (nameBox.Text:gsub("^%s+", ""))
	trimmed = (trimmed:gsub("%s+$", ""))
	local name = trimmed
	if utf8.len(name) and utf8.len(name) > 24 then
		name = string.sub(name, 1, utf8.offset(name, 25) - 1)
	end
	if name == "" then name = "UNTITLED" end
	local cur = path[#path]
	if pendingKind == "folder" then
		table.insert(cur.children, { kind = "folder", name = name, icon = pendingIcon, children = {} })
	else
		table.insert(cur.children, { kind = "file", name = name, icon = "file", content = "" })
	end
	dialog.Visible = false
	queueSave()
	render()
end)

function render()
	for _, c in ipairs(grid:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local cur = path[#path]

	local names = {}
	for i = 2, #path do names[#names + 1] = path[i].name end
	pathLbl.Text = "ROOT" .. (#names > 0 and ("/" .. table.concat(names, "/")) or "")

	backB.Visible = #path > 1
	local inFolder = #path > 1
	fileB.Active = inFolder
	fileB.AutoButtonColor = inFolder
	fileB.TextColor3 = inFolder and C.text or Color3.fromRGB(205, 180, 100)
	fileB.UIStroke.Color = inFolder and C.yellowDim or Color3.fromRGB(225, 200, 110)

	delB.BackgroundColor3 = deleteMode and C.yellow or C.btn

	emptyLbl.Visible = #cur.children == 0

	for idx, node in ipairs(cur.children) do
		local it = mk("TextButton", {
			Text = "", BackgroundColor3 = C.field, BackgroundTransparency = .25, BorderSizePixel = 0, LayoutOrder = idx,
		}, grid)
		stroke(it, deleteMode and C.text or C.yellowDim, 1)
		icon(it, node.icon, 52).Position = UDim2.new(.5, -26, 0, 5)
		local nl = label(it, node.name, 13, C.text)
		nl.Position = UDim2.fromOffset(4, 60)
		nl.Size = UDim2.new(1, -8, 0, 28)
		nl.TextWrapped = true
		nl.TextTruncate = Enum.TextTruncate.AtEnd
		if deleteMode then
			local x = label(it, "x", 16, C.text)
			x.Position = UDim2.new(1, -18, 0, 0)
			x.Size = UDim2.fromOffset(18, 18)
		end
		it.Activated:Connect(function()
			if deleteMode then
				table.remove(cur.children, idx)
				queueSave()
				render()
			elseif node.kind == "folder" then
				table.insert(path, node)
				render()
			else
				openEditor(node)
			end
		end)
	end
end

backB.Activated:Connect(function()
	if #path > 1 then table.remove(path); render() end
end)
