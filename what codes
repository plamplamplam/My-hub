local render

local function openDialog(kind)
	pendingKind = kind
	pendingIcon = (kind == "folder") and "folder" or "file"
	dTitle.Text = (kind == "folder") and "NEW FOLDER" or "NEW FILE"
	nameBox.Text = ""
	picker.Visible = (kind == "folder")
	refreshPicker()
