-- เซฟ/โหลด (คุยกับ Script เซฟของแต่ละคน ผ่าน RemoteFunction)
---------------------------------------------------------------------
local function markDirty()
	dirty = true
	if canSave then setStatus("มีการเปลี่ยนแปลง…") end
end

local function flush()
	if not (canSave and dirty and remote) then return end
	dirty = false
	setStatus("กำลังบันทึก…")
	local ok, res = pcall(function()
		return remote:InvokeServer("save", HttpService:JSONEncode(root.kids))
	end)
	if ok and res then
		setStatus("● บันทึกแล้ว", Color3.fromRGB(190, 230, 140))
	else
		dirty = true
		setStatus("บันทึกไม่สำเร็จ ลองใหม่…", Color3.fromRGB(255, 190, 150))
	end
end

task.spawn(function()
	while true do
		task.wait(2)
		flush()
	end
end)

-- ล้างข้อมูลที่โหลดมาให้อยู่ในรูปแบบที่ถูกต้อง
local function clean(node, depth)
	if type(node) ~= "table" or depth > 40 then return nil end
	local n = { t = (node.t == "f") and "f" or "d", name = string.sub(tostring(node.name or "ไม่มีชื่อ"), 1, 40) }
	if n.t == "f" then
		n.icon = type(node.icon) == "string" and string.sub(node.icon, 1, 40) or ""
		n.kids = {}
		if type(node.kids) == "table" then
			for _, k in ipairs(node.kids) do
				local c = clean(k, depth + 1)
				if c then table.insert(n.kids, c) end
			end
		end
	else
		n.content = type(node.content) == "string" and node.content or ""
	end
	return n
end

