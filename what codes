local saveEv = ReplicatedStorage:WaitForChild("MortyArchiveSave", 10)
local canSave = false
local saveToken = 0
local function queueSave()
	if not canSave or not saveEv then return end
	saveToken += 1
	local t = saveToken
	task.delay(1, function()
		if t == saveToken then saveEv:FireServer(root.children) end
	end)
end

