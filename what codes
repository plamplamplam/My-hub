-- โหลดข้อมูลที่เคยเซฟไว้ (ถ้ามี Script เซฟฝั่งเซิร์ฟเวอร์)
---------------------------------------------------------------------
if not USE_SERVER_SAVE then
	setStatus("โหมดในเกม: ข้อมูลอยู่จนกว่าจะออกเกม", TINT2)
	return
end

task.spawn(function()
	local r = ReplicatedStorage:WaitForChild("FileManagerRemote", 6)
	if not r then
		setStatus("ออฟไลน์: ยังไม่ได้เชื่อมระบบเซฟ", Color3.fromRGB(255, 190, 150))
		return
	end
	setStatus("กำลังโหลด…")
	local ok, loadedOk, data = pcall(function() return r:InvokeServer("load") end)
	if not (ok and loadedOk) then
		setStatus("โหลดข้อมูลไม่สำเร็จ (ไม่เซฟทับของเดิม)", Color3.fromRGB(255, 190, 150))
		return
	end
	remote = r
	canSave = true
	if type(data) == "string" and data ~= "" then
		local decoded
		local okJson = pcall(function() decoded = HttpService:JSONDecode(data) end)
		if okJson and type(decoded) == "table" then
			local kids = {}
			for _, k in ipairs(decoded) do
				local c = clean(k, 1)
				if c and c.t == "f" then table.insert(kids, c) end -- ชั้นบนสุดมีได้แต่แฟ้ม
			end
			root.kids = kids
			path = { root }
			render()
		end
	end
	setStatus("● บันทึกอัตโนมัติ", Color3.fromRGB(190, 230, 140))
end)
