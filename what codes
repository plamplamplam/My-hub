------------------------------------------------------------ helpers
local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function stroke(o, color, thick)
	return mk("UIStroke", {
		Color = color, Thickness = thick or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
end

local function btn(parent, text, x, y, w, h, right)
	local b = mk("TextButton", {
		Text = text, Font = Enum.Font.Code, TextSize = 12,
		TextColor3 = C.text, BackgroundColor3 = C.btn, BackgroundTransparency = .2, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(right and 1 or 0, 0),
		Position = UDim2.new(right and 1 or 0, x, 0, y),
		Size = UDim2.fromOffset(w, h),
	}, parent)
	stroke(b, C.yellowDim, 1)
	return b
end

local function label(parent, text, size, color)
	return mk("TextLabel", {
		Text = text, Font = Enum.Font.Code, TextSize = size or 14,
		TextColor3 = color or C.text, BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, parent)
end

------------------------------------------------------------ icons (drawn from squares)
local function icon(parent, kind, s)
	local f = mk("Frame", { Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1 }, parent)
	local function r(x, y, w, h, c, rot, p)
		local fr = mk("Frame", {
			Position = UDim2.fromOffset(x * s, y * s),
			Size = UDim2.fromOffset(w * s, h * s),
			BackgroundColor3 = c, BorderSizePixel = 0, Rotation = rot or 0,
		}, p or f)
		if c == C.yellow then stroke(fr, C.yellowDim, 1) end
		return fr
	end

	if kind == "folder" then
		r(.08, .18, .38, .20, C.yellowDim)
		r(.08, .28, .84, .58, C.yellow)
		r(.08, .38, .84, .04, C.yellowDim)
	elseif kind == "drive" then -- flash drive
		r(.10, .30, .58, .40, C.yellow)
		r(.68, .38, .22, .24, C.yellowDim)
		r(.74, .43, .06, .06, C.hole)
		r(.74, .52, .06, .06, C.hole)
		r(.16, .40, .12, .20, C.hole)
	elseif kind == "house" then
		local clip = mk("Frame", {
			Position = UDim2.fromOffset(.08 * s, .08 * s),
			Size = UDim2.fromOffset(.84 * s, .42 * s),
			BackgroundTransparency = 1, ClipsDescendants = true,
		}, f)
		local side = (.84 * s) / 1.4142
		mk("Frame", {
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(.5, 0, 1, 0),
			Size = UDim2.fromOffset(side, side), Rotation = 45,
			BackgroundColor3 = C.yellowDim, BorderSizePixel = 0,
		}, clip)
		r(.18, .50, .64, .38, C.yellow)
		r(.44, .62, .12, .26, C.hole)
	elseif kind == "gem" then
		r(.22, .22, .56, .56, C.yellow, 45)
		r(.38, .38, .24, .24, C.hole, 45)
	elseif kind == "file" then
		r(.24, .10, .52, .78, C.yellow)
		r(.58, .10, .18, .16, C.field)
		r(.32, .42, .36, .05, C.yellowDim)
		r(.32, .54, .36, .05, C.yellowDim)
		r(.32, .66, .24, .05, C.yellowDim)
	elseif kind == "patch" then -- Evil Morty eyepatch
		r(-.05, .47, 1.10, .07, C.yellowDim, -22)
		r(.27, .27, .46, .46, C.yellow)
		r(.31, .31, .38, .38, C.hole)
	end
	return f
end

