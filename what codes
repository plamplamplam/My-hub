		table.insert(cur.kids, { t = "f", name = name, icon = icon, kids = {} })
		markDirty()
		render()
	end)
end

local function newFileIn(cur)
	fileDialog(nil, function(name, text)
		table.insert(cur.kids, { t = "d", name = name, content = text })
		markDirty()
		render()
		toast("สร้างไฟล์แล้ว")
	end)
end

addBtn.MouseButton1Click:Connect(function()
	local cur = path[#path]
	if #path == 1 then
		-- ชั้นบนสุด: เพิ่มได้แต่แฟ้ม
		newFolderIn(cur)
