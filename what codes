	local chosen = existing and existing.icon or ""
	local digits = string.match(chosen, "^rbxassetid://(%d+)$")

	smallLabel(panel, 232, "หรือใส่ ID รูปจาก Roblox (ตัวเลข)")
	local idBox = textField(panel, UDim2.fromOffset(14, 254), UDim2.new(1, -28, 0, 32), "เช่น 123456789", digits or "")

	local grid = make("ScrollingFrame", {
		Position = UDim2.fromOffset(14, 134), Size = UDim2.new(1, -28, 0, 90),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, panel)
	make("UIGridLayout", { CellSize = UDim2.fromOffset(36, 36), CellPadding = UDim2.fromOffset(4, 4), SortOrder = Enum.SortOrder.LayoutOrder }, grid)

	local btns = {}
	local function refresh()
		for ic, b in pairs(btns) do
			b.BackgroundColor3 = (ic == chosen and idBox.Text == "") and FOLDER or TINT
		end
	end
	for i, ic in ipairs(ICONS) do
		local b = make("TextButton", {
			LayoutOrder = i, BackgroundColor3 = TINT, BorderSizePixel = 0,
			Text = (ic == "") and "–" or ic, TextSize = 22, TextColor3 = INK,
			Font = Enum.Font.SourceSans, AutoButtonColor = false,
		}, grid)
		btns[ic] = b
		b.MouseButton1Click:Connect(function()
			chosen = ic
			idBox.Text = ""
			refresh()
		end)
	end
	idBox:GetPropertyChangedSignal("Text"):Connect(refresh)
	refresh()

	local cancel = button(panel, "ยกเลิก", UDim2.fromOffset(100, 36), UDim2.new(1, -226, 1, -48), TINT, TINT2, BROWN)
	local ok = button(panel, "ตกลง", UDim2.fromOffset(100, 36), UDim2.new(1, -114, 1, -48), BROWN, DARK, WHITE)
	stroke(cancel, LINE, 1)
	cancel.MouseButton1Click:Connect(closeModal)
	ok.MouseButton1Click:Connect(function()
		local name = string.sub(trim(nameBox.Text), 1, 40)
		if name == "" then name = "แฟ้มใหม่" end
		local d = string.match(idBox.Text, "%d+")
		local icon = d and ("rbxassetid://" .. d) or chosen
		closeModal()
		onDone(name, icon)
	end)
end

